<?xml version="1.0" encoding="utf-8"?>
<!-- Поверхность иконки целиком — mask-safe-v8: арка вписана в видимую зону
     adaptive-иконки, поэтому маска лаунчера срезает только фон. Витринная
     иконка для сторов делается из того же исходника (docs/icons/store-512.png):
     RuStore требует, чтобы на витрине и на устройстве иконка совпадала. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_full" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>

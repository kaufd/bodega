<?xml version="1.0" encoding="utf-8"?>
<!-- Окно под системным splash на Android 12+: только фон, тот же, что у экранов,
     чтобы между splash и первым кадром не мелькала белая заливка. Надпись сюда
     не кладём — её рисует сам splash (windowSplashScreenAnimatedIcon), а вторая
     копия в этом окне сдвинулась бы на высоту статус-бара. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_ambient" />
</layer-list>

    <!-- Вино -->
    <string name="quote_wine_galileo">Вино — это солнечный свет, удержанный водой.</string>
    <string name="quote_wine_galileo_author">Галилео Галилей</string>
    <string name="quote_wine_stevenson">Вино — поэзия в бутылке.</string>
    <string name="quote_wine_stevenson_author">Роберт Льюис Стивенсон</string>
    <string name="quote_wine_pliny">Истина — в вине.</string>
    <string name="quote_wine_pliny_author">Плиний Старший</string>
    <string name="quote_wine_horace">Стихи, написанные любителями воды, долго не живут.</string>
    <string name="quote_wine_horace_author">Гораций</string>
    <string name="quote_wine_bacon">Старое вино пьют, старым друзьям доверяют, старых авторов читают.</string>
    <string name="quote_wine_bacon_author">Фрэнсис Бэкон</string>
    <string name="quote_wine_shakespeare">Вино — добрый товарищ, если обращаться с ним разумно.</string>
    <string name="quote_wine_shakespeare_author">Уильям Шекспир</string>
    <string name="quote_wine_aristophanes">Несите чашу вина: смочу ум и скажу что-нибудь умное.</string>
    <string name="quote_wine_aristophanes_author">Аристофан</string>

    <!-- Пиво -->
    <string name="quote_beer_poe">Пусть время идёт — сегодня я пью эль.</string>
    <string name="quote_beer_poe_author">Эдгар Аллан По</string>
    <string name="quote_beer_housman">Солод не хуже поэзии оправдывает пути Господни.</string>
    <string name="quote_beer_housman_author">Альфред Хаусман</string>
    <string name="quote_beer_henry">Я отдал бы всю славу за кружку эля и безопасность.</string>
    <string name="quote_beer_henry_author">Уильям Шекспир</string>
    <string name="quote_beer_german">Пиво — жидкий хлеб.</string>
    <string name="quote_beer_german_author">Немецкая поговорка</string>
    <string name="quote_beer_english">Хороший эль и кошку заставит заговорить.</string>
    <string name="quote_beer_english_author">Английская поговорка</string>
    <string name="quote_beer_king">Кварта эля — угощение для короля.</string>
    <string name="quote_beer_king_author">Уильям Шекспир</string>
    <string name="quote_beer_hops">Хмель и солод — да хранит их Бог.</string>
    <string name="quote_beer_hops_author">Немецкая поговорка</string>

    <!-- Крепкие напитки -->
    <string name="quote_spirit_shaw">Виски — это жидкий солнечный свет.</string>
    <string name="quote_spirit_shaw_author">Бернард Шоу</string>
    <string name="quote_spirit_twain">Слишком много хорошего виски — едва ли достаточно.</string>
    <string name="quote_spirit_twain_author">Марк Твен</string>
    <string name="quote_spirit_fields">Всегда носите с собой виски на случай укуса змеи — и маленькую змею.</string>
    <string name="quote_spirit_fields_author">Уильям Клод Филдс</string>
    <string name="quote_spirit_burns">Свобода и виски идут вместе.</string>
    <string name="quote_spirit_burns_author">Роберт Бёрнс</string>
    <string name="quote_spirit_remarque">Это будет кальвадос с привкусом мечты о совсем другом кальвадосе.</string>
    <string name="quote_spirit_remarque_author">Эрих Мария Ремарк</string>
    <string name="quote_spirit_irish">Чего не вылечит виски, то уже неизлечимо.</string>
    <string name="quote_spirit_irish_author">Ирландская поговорка</string>
    <string name="quote_spirit_bi2">Какой русский не пьёт виски?</string>
    <string name="quote_spirit_bi2_author">Би-2</string>

